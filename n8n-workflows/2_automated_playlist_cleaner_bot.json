{
  "name": "M3U PLAY - Limpador & Sanitizador Automático de Playlists M3U",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clean-m3u",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-in",
      "name": "Webhook: Receber Link M3U",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "m3u-clean-incoming"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/webhooks/validate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "m3u_secret_key_889922aabbcc"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.body.m3u_url || $json.body.url }}\",\n  \"name\": \"{{ $json.body.playlist_name || 'Lista Sanitizada n8n' }}\",\n  \"concurrency\": 20,\n  \"timeout\": 3000\n}",
        "options": {}
      },
      "id": "node-import-and-check",
      "name": "Importar & Iniciar Validação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "amount": 6,
        "unit": "seconds"
      },
      "id": "node-wait-clean",
      "name": "Aguardar Teste dos Canais",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [680, 300],
      "webhookId": "m3u-wait-clean"
    },
    {
      "parameters": {
        "url": "=http://localhost:3000/api/automation/check/{{ $json.playlistId }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "m3u_secret_key_889922aabbcc"
            }
          ]
        },
        "options": {}
      },
      "id": "node-get-clean-status",
      "name": "Verificar Canais Online",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "const status = $input.first().json;\nconst playlistId = status.playlistId;\n\nconst cleanDownloadUrl = `http://localhost:3000/api/playlists/${playlistId}/export?filter=online`;\nconst playerWebUrl = `http://localhost:3000/#/player`;\n\nreturn {\n  json: {\n    success: true,\n    playlistId,\n    onlineChannels: status.onlineCount || 0,\n    lastChecked: status.lastChecked,\n    downloadM3uUrl: cleanDownloadUrl,\n    webPlayerUrl: playerWebUrl,\n    message: `🎉 Sua lista foi limpa com sucesso! ${status.onlineCount} canais online disponíveis para reprodução imediata.`\n  }\n};"
      },
      "id": "node-response-clean",
      "name": "Gerar Links de Download & Player",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "Webhook: Receber Link M3U": {
      "main": [
        [
          {
            "node": "Importar & Iniciar Validação",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Importar & Iniciar Validação": {
      "main": [
        [
          {
            "node": "Aguardar Teste dos Canais",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aguardar Teste dos Canais": {
      "main": [
        [
          {
            "node": "Verificar Canais Online",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verificar Canais Online": {
      "main": [
        [
          {
            "node": "Gerar Links de Download & Player",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
