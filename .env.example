# ==============================================================================
# JstudioPlay Pro — ENVIRONMENT TEMPLATE
# Copie para CREDENCIAIS/.env e preencha com valores seguros.
# NUNCA commite o arquivo .env real — ele está blindado no .gitignore.
# ==============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3030
HOST=0.0.0.0
NODE_ENV=production

# ── Autenticação ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
API_SECRET_KEY=generate_a_random_32_byte_hex_string
SESSION_SECRET=generate_another_random_32_byte_hex_string

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180

# ── Scraper & Stream Check ────────────────────────────────────────────────────
STREAM_PROBE_CONCURRENCY=20
STREAM_PROBE_TIMEOUT_MS=3500

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your_google_client_id_here
# ADMIN_EMAIL=seu_email_admin@gmail.com

# ── n8n Integration ───────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://mcp_n8n:5678/webhook/m3u-ops
N8N_ALERT_WEBHOOK_URL=http://mcp_n8n:5678/webhook/m3u-alerts
JSTUDIOPLAY_API_KEY=generate_a_random_32_byte_hex_string
JSTUDIOPLAY_INTERNAL_URL=http://mcp_jstudioplay:3030
# JSTUDIOPLAY_PUBLIC_URL=https://seu-tunnel.trycloudflare.com

# ── Ollama (LLM local) ────────────────────────────────────────────────────────
OLLAMA_URL=http://mcp_ollama:11434
OLLAMA_LLM_MODEL=hermes3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Canais por batch no enriquecimento AI (ajuste conforme GPU disponível)
AI_ENRICH_BATCH=50

# ── pgvector (busca semântica) ────────────────────────────────────────────────
PGVECTOR_HOST=mcp_postgres_vector
PGVECTOR_PORT=5432
PGVECTOR_DB=mcp_knowledge
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres

# ── SearXNG (descoberta dinâmica de fontes) ───────────────────────────────────
SEARXNG_URL=http://mcp_searxng:8080
