# ==============================================================================
# M3U PLAY PRO v7.1 — ENVIRONMENT TEMPLATE (EXAMPLE)
# Copie este arquivo para .env e preencha com suas credenciais seguras.
# ==============================================================================

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
API_SECRET_KEY=generate_a_random_32_byte_hex_string
SESSION_SECRET=generate_another_random_32_byte_hex_string

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180

SYNC_M3U_INTERVAL_MINUTES=10
SYNC_EPG_INTERVAL_MINUTES=30
HEALTH_CHECK_INTERVAL_MINUTES=5

STREAM_PROBE_CONCURRENCY=20
STREAM_PROBE_TIMEOUT_MS=3500

N8N_WEBHOOK_URL=http://localhost:5678/webhook/m3u-ops
N8N_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/m3u-alerts
