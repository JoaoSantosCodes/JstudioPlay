{
  "name": "JstudioPlay — Ops Orchestrator (Sync + Health + Alertas)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] }
      },
      "id": "node_cron_m3u",
      "name": "Cron: Sync M3U (10min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 200]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "id": "node_cron_epg",
      "name": "Cron: Sync EPG (30min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 400]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "node_cron_health",
      "name": "Cron: Health Check (5min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [100, 600]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/ops/trigger-m3u",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "node_http_m3u",
      "name": "POST: Sincronizar M3U",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/ops/trigger-epg",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "node_http_epg",
      "name": "POST: Atualizar EPG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/ops/trigger-health",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "node_http_health",
      "name": "POST: Stream Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [380, 600]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{
            "id": "cond-health",
            "leftValue": "={{ $json.healthScore }}",
            "rightValue": 90,
            "operator": { "type": "number", "operation": "lt" }
          }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node_if_degraded",
      "name": "Health Score < 90%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 600]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: {\n  alert: `🚨 *Alerta JstudioPlay — Degradação*\\n- Health: ${d.healthScore}%\\n- Down: ${d.counts?.streamsDown || '?'} canais\\n- ⏰ ${new Date().toLocaleString('pt-BR')}`,\n  healthScore: d.healthScore,\n  streamsDown: d.counts?.streamsDown\n}}];"
      },
      "id": "node_format_alert",
      "name": "Formatar Alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 540]
    }
  ],
  "connections": {
    "Cron: Sync M3U (10min)": { "main": [[{ "node": "POST: Sincronizar M3U", "type": "main", "index": 0 }]] },
    "Cron: Sync EPG (30min)": { "main": [[{ "node": "POST: Atualizar EPG", "type": "main", "index": 0 }]] },
    "Cron: Health Check (5min)": { "main": [[{ "node": "POST: Stream Health Check", "type": "main", "index": 0 }]] },
    "POST: Stream Health Check": { "main": [[{ "node": "Health Score < 90%?", "type": "main", "index": 0 }]] },
    "Health Score < 90%?": { "main": [[{ "node": "Formatar Alerta", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
