{
  "name": "JstudioPlay - Validador de Streams & Alertas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 6 }]
        }
      },
      "id": "node-schedule",
      "name": "Agendador (Cada 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/playlists",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "node-get-playlists",
      "name": "Buscar Playlists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filtra apenas playlists com URL (não as locais)\nconst playlists = $input.all().map(i => i.json).filter(p => p.url && p.total > 0);\nreturn playlists.map(p => ({ json: p }));"
      },
      "id": "node-filter-playlists",
      "name": "Filtrar Playlists com URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/automation/check/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"concurrency\": 15, \"timeout\": 3500 }",
        "options": {}
      },
      "id": "node-trigger-check",
      "name": "Disparar Validação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": { "amount": 8, "unit": "seconds" },
      "id": "node-wait",
      "name": "Aguardar Processamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1080, 300],
      "webhookId": "m3u-wait-check"
    },
    {
      "parameters": {
        "url": "={{ $env.JSTUDIOPLAY_INTERNAL_URL }}/api/automation/check/{{ $('Disparar Validação').item.json.playlistId }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.JSTUDIOPLAY_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "node-check-status",
      "name": "Obter Status da Checagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{
            "id": "cond-online",
            "leftValue": "={{ $json.onlineCount }}",
            "rightValue": 0,
            "operator": { "type": "number", "operation": "gt" }
          }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-health",
      "name": "Tem Canais Online?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "jsCode": "const status = $input.first().json;\nconst playlistId = status.playlistId || $('Disparar Validação').item.json.playlistId;\nconst total = status.total || 0;\nconst online = status.onlineCount || status.online || 0;\nconst offline = total - online;\nconst rate = total > 0 ? Math.round((online / total) * 100) : 0;\nconst baseUrl = $env.JSTUDIOPLAY_INTERNAL_URL || 'http://mcp_jstudioplay:3030';\n\nreturn [{ json: {\n  message: `✅ *Relatório de Monitoramento — JstudioPlay*\\n━━━━━━━━━━━━━━━━━━\\n🟢 Online: ${online}  🔴 Offline: ${offline}  📊 ${rate}%\\n📥 M3U Limpa: ${baseUrl}/api/playlists/${playlistId}/export?filter=online\\n⏰ ${new Date().toLocaleString('pt-BR')}`,\n  playlistId, online, offline, rate\n}}];"
      },
      "id": "node-format-report",
      "name": "Formatar Relatório",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 200]
    }
  ],
  "connections": {
    "Agendador (Cada 6h)": { "main": [[{ "node": "Buscar Playlists", "type": "main", "index": 0 }]] },
    "Buscar Playlists": { "main": [[{ "node": "Filtrar Playlists com URL", "type": "main", "index": 0 }]] },
    "Filtrar Playlists com URL": { "main": [[{ "node": "Disparar Validação", "type": "main", "index": 0 }]] },
    "Disparar Validação": { "main": [[{ "node": "Aguardar Processamento", "type": "main", "index": 0 }]] },
    "Aguardar Processamento": { "main": [[{ "node": "Obter Status da Checagem", "type": "main", "index": 0 }]] },
    "Obter Status da Checagem": { "main": [[{ "node": "Tem Canais Online?", "type": "main", "index": 0 }]] },
    "Tem Canais Online?": { "main": [[{ "node": "Formatar Relatório", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
